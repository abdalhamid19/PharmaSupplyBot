# ── Local SQLite Manual Review Database ──
# Optional: override default path (state/manual_review_decisions.db)
# SQLITE_DB_PATH=state/manual_review_decisions.db

# ── Optional: CockroachDB Cloud (only for one-time export when credits return) ──
# DB_HOST=your-database-host-here
# DB_PORT=26257
# DB_NAME=your-database-name-here
# DB_USER=your-database-user-here
# DB_PASSWORD=your-database-password-here
# DB_SSLMODE=require

# ── Tawreed Credentials ──
# Optional: set credentials here if login page supports direct fill.
# If you prefer manual login, you can leave these blank and just run `auth`.
TAWREED_EMAIL=your-tawreed-email@example.com
TAWREED_PASSWORD=your-tawreed-password

# ── Provider API Keys ──
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_API_KEY_1=your-openrouter-api-key-1-here
OPENROUTER_API_KEY_2=your-openrouter-api-key-2-here
OPENROUTER_API_KEY_3=your-openrouter-api-key-3-here
OPENROUTER_API_KEY_4=your-openrouter-api-key-4-here
OPENROUTER_API_KEY_5=your-openrouter-api-key-5-here
OPENROUTER_API_KEY_6=your-openrouter-api-key-6-here
# ── OpenCode API Keys (multiple keys for rotation) ──
OPENCODE_API_KEY_1=your-opencode-api-key-1-here
OPENCODE_API_KEY_2=your-opencode-api-key-2-here
OPENCODE_API_KEY_3=your-opencode-api-key-3-here
OPENCODE_API_KEY_4=your-opencode-api-key-4-here
OPENCODE_API_KEY_5=your-opencode-api-key-5-here
OPENCODE_API_KEY_6=your-opencode-api-key-6-here
# Keep legacy single key for backward compat
OPENCODE_API_KEY=your-opencode-api-key-here
# ── Default API Config ──

# ── Fallback Models (tried in order when API fails) ──
AI_MODEL=minimax-m2.5-free
FALLBACK_MODELS=nemotron-3-super-free,hy3-preview-free,trinity-large-preview-free

# ── Review Model (second AI to cross-verify low-confidence decisions) ──
REVIEW_MODEL=big-pickle

# ── Review confidence threshold ──
AI_REVIEW_THRESHOLD=0.95

GROQ_API_KEY_1=your-groq-api-key-1-here
GROQ_API_KEY_2=your-groq-api-key-2-here
GROQ_API_KEY_3=your-groq-api-key-3-here
GROQ_API_KEY_4=your-groq-api-key-4-here
GROQ_API_KEY_5=your-groq-api-key-5-here
GROQ_API_KEY_6=your-groq-api-key-6-here

# -- GitHub Models API Keys --
GITHUB_API_KEY_1=your-github-api-key-1-here
GITHUB_API_KEY_2=your-github-api-key-2-here
GITHUB_API_KEY_3=your-github-api-key-3-here
GITHUB_API_KEY_4=your-github-api-key-4-here
GITHUB_API_KEY_5=your-github-api-key-5-here
GITHUB_API_KEY_6=your-github-api-key-6-here
GITHUB_API_KEY=your-github-api-key-here
# Per-provider rotation models live in config.yaml under `ai.providers.github.models`.
# Override per-run with: GITHUB_MODELS=model-a,model-b (CSV wins over YAML).

# -- Cloudflare Workers AI API Tokens --
CLOUDFLARE_API_TOKEN_1=your-cloudflare-api-token-1-here
CLOUDFLARE_API_TOKEN_2=your-cloudflare-api-token-2-here
CLOUDFLARE_API_TOKEN_3=your-cloudflare-api-token-3-here
CLOUDFLARE_API_TOKEN_4=your-cloudflare-api-token-4-here
CLOUDFLARE_API_TOKEN_5=your-cloudflare-api-token-5-here
CLOUDFLARE_API_TOKEN_6=your-cloudflare-api-token-6-here
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID_1=your-cloudflare-account-id-1-here
CLOUDFLARE_ACCOUNT_ID_2=your-cloudflare-account-id-2-here
CLOUDFLARE_ACCOUNT_ID_3=your-cloudflare-account-id-3-here
CLOUDFLARE_ACCOUNT_ID_4=your-cloudflare-account-id-4-here
CLOUDFLARE_ACCOUNT_ID_5=your-cloudflare-account-id-5-here
CLOUDFLARE_ACCOUNT_ID_6=your-cloudflare-account-id-6-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your-account-id/ai/v1
# Per-provider rotation models live in config.yaml under `ai.providers.cloudflare.models`.
# Override per-run with: CLOUDFLARE_MODELS=model-a,model-b (CSV wins over YAML).

# -- Cerebras API Keys --
CEREBRAS_API_KEY_1=your-cerebras-api-key-1-here
CEREBRAS_API_KEY_2=your-cerebras-api-key-2-here
CEREBRAS_API_KEY_3=your-cerebras-api-key-3-here
CEREBRAS_API_KEY_4=your-cerebras-api-key-4-here
CEREBRAS_API_KEY_5=your-cerebras-api-key-5-here
CEREBRAS_API_KEY_6=your-cerebras-api-key-6-here
CEREBRAS_API_KEY=your-cerebras-api-key-here
# Per-provider rotation models live in config.yaml under `ai.providers.cerebras.models`.
# Override per-run with: CEREBRAS_MODELS=model-a,model-b (CSV wins over YAML).

# -- Google Gemini API Keys --
GOOGLE_API_KEY_1=your-google-api-key-1-here
GOOGLE_API_KEY_2=your-google-api-key-2-here
GOOGLE_API_KEY_3=your-google-api-key-3-here
GOOGLE_API_KEY_4=your-google-api-key-4-here
GOOGLE_API_KEY=your-google-api-key-here
# Per-provider rotation models live in config.yaml under `ai.providers.google.models`.
# Override per-run with: GOOGLE_MODELS=model-a,model-b (CSV wins over YAML).

# -- Mistral API Keys --
MISTRAL_API_KEY_1=your-mistral-api-key-1-here
MISTRAL_API_KEY_2=your-mistral-api-key-2-here
MISTRAL_API_KEY_3=your-mistral-api-key-3-here
MISTRAL_API_KEY_4=your-mistral-api-key-4-here
MISTRAL_API_KEY_5=your-mistral-api-key-5-here
MISTRAL_API_KEY_6=your-mistral-api-key-6-here
MISTRAL_API_KEY=your-mistral-api-key-here
# Per-provider rotation models live in config.yaml under `ai.providers.mistral.models`.
# Override per-run with: MISTRAL_MODELS=model-a,model-b (CSV wins over YAML).
