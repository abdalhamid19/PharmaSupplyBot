# Local SQLite manual-review database (optional)
# SQLITE_DB_PATH=state/manual_review_decisions.db

# Optional CockroachDB connection
# DB_HOST=your-database-host-here
# DB_PORT=26257
# DB_NAME=your-database-name-here
# DB_USER=your-database-user-here
# DB_PASSWORD=your-database-password-here
# DB_SSLMODE=require

# Tawreed login credentials (optional; manual login remains supported)
TAWREED_EMAIL=your-tawreed-email@example.com
TAWREED_PASSWORD=your-tawreed-password

# Cohere (optional; powers bilingual Arabic→English drug name translation
# for single-column Arabic Excel target catalogs)
# Keep real keys only in the local .env or process environment.
COHERE_API_KEY_1=your-first-cohere-api-key
COHERE_API_KEY_2=your-second-cohere-api-key
COHERE_BATCH_SIZE=50
# Optional: cap Cohere API rate (default 20/min) to stay under the trial
# key's 20/minute limit.
COHERE_RATE_LIMIT_PER_MIN=20
COHERE_TRANSLATION_MODEL=command-a-translate-08-2025
